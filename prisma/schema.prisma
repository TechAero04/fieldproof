generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// PART 4: MULTI-TENANT SAAS ARCHITECTURE
// -------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  industry    String?  // e.g. "Construction", "Manufacturing", "Logistics", "Facilities"
  website     String?
  phone       String?
  address     String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan        String   @default("ENTERPRISE")
  settings    String?  // JSON string for configurable org policies
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships       OrganizationMembership[]
  departments       Department[]
  teams             Team[]
  sites             Site[]
  assets            Asset[]
  templates         InspectionTemplate[]
  inspections       Inspection[]
  findings          Finding[]
  correctiveActions CorrectiveAction[]
  auditLogs         AuditLog[]
  reports           Report[]
  notifications     Notification[]
}

// User Master Table (Global across platform, members of multiple orgs)
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  title        String?
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Tenant Memberships
  memberships         OrganizationMembership[]
  
  // Direct Action Relationships
  assignedInspections Inspection[]              @relation("InspectorInspections")
  createdInspections  Inspection[]              @relation("CreatorInspections")
  assignedActions     CorrectiveAction[]        @relation("ActionAssignee")
  verifiedActions     CorrectiveAction[]        @relation("ActionVerifier")
  createdTemplates    InspectionTemplate[]      @relation("TemplateCreator")
  reviews             InspectionReview[]
  comments            CorrectiveActionComment[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  syncOperations      OfflineSyncOperation[]
}

// Multi-Tenant Membership & Role Binding
model OrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  // Roles: SUPER_ADMIN, ORG_ADMIN, MANAGER, INSPECTOR, ASSIGNEE, AUDITOR
  role           String       @default("INSPECTOR")
  title          String?
  departmentId   String?
  teamId         String?
  isActive       Boolean      @default(true)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  memberships  OrganizationMembership[]

  @@unique([organizationId, name])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  memberships  OrganizationMembership[]
}

// -------------------------------------------------------------
// PART 21: SITE & PHYSICAL ASSET MANAGEMENT
// -------------------------------------------------------------

model Site {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?  // e.g. "DAL-WH-04"
  address        String
  city           String?
  state          String?
  country        String?  @default("USA")
  postalCode     String?
  latitude       Float?
  longitude      Float?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  inspections  Inspection[]
  findings     Finding[]
  actions      CorrectiveAction[]

  @@index([organizationId])
}

model Asset {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  assetTag       String   // Unique identifier barcode / QR code
  category       String   // e.g. "HVAC System", "Fire Suppression", "Heavy Crane", "Electrical Switchgear"
  modelNumber    String?
  serialNumber   String?
  manufacturer   String?
  locationInSite String?  // e.g. "Roof Deck Area 3", "Fabrication Bay 2"
  qrCodeUrl      String?  // Generated QR Code data / URL
  status         String   @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE_REQUIRED, OUT_OF_SERVICE
  lastInspected  DateTime?
  nextDue        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  inspections  Inspection[]
  findings     Finding[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, siteId])
}

// -------------------------------------------------------------
// PART 7: INSPECTION TEMPLATES & VERSIONING
// -------------------------------------------------------------

model InspectionTemplate {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  category       String   // e.g. "OSHA Safety", "Fire & Egress", "Quality Control", "Asset Integrity"
  isActive       Boolean  @default(true)
  currentVersion Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("TemplateCreator", fields: [createdById], references: [id])
  versions     TemplateVersion[]
  inspections  Inspection[]

  @@index([organizationId])
}

model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int
  title       String
  description String?
  scoringRule String?  // JSON scoring logic (e.g. weighted pass/fail, percentage threshold)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sections    TemplateSection[]
  inspections Inspection[]

  @@unique([templateId, version])
}

model TemplateSection {
  id                String   @id @default(cuid())
  templateVersionId String
  title             String
  description       String?
  orderIndex        Int      @default(0)

  templateVersion TemplateVersion    @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  questions       TemplateQuestion[]

  @@index([templateVersionId])
}

model TemplateQuestion {
  id          String   @id @default(cuid())
  sectionId   String
  questionText String
  // Types: PASS_FAIL_NA, YES_NO, SINGLE_CHOICE, MULTI_CHOICE, TEXT, NUMBER, DATE, TIME, PHOTO, VIDEO, GPS, SIGNATURE, DROPDOWN, RATING, MEASUREMENT
  questionType String   @default("PASS_FAIL_NA")
  options      String?  // JSON array for choice/dropdown options
  isRequired   Boolean  @default(true)
  requirePhoto Boolean  @default(false)
  helpText     String?
  orderIndex   Int      @default(0)
  // Conditional logic JSON: e.g. show this question only if question X is FAIL
  conditionalRule String?
  weight       Float    @default(1.0)

  section   TemplateSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses InspectionResponse[]
  findings  Finding[]
  evidence  EvidenceFile[]

  @@index([sectionId])
}

// -------------------------------------------------------------
// PART 8: INSPECTION MANAGEMENT & VALID STATE MACHINE
// -------------------------------------------------------------

model Inspection {
  id                String    @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  templateId        String
  templateVersionId String
  siteId            String?
  assetId           String?
  inspectorId       String?
  createdById       String

  // Status Lifecycle: DRAFT, ASSIGNED, IN_PROGRESS, SUBMITTED, CHANGES_REQUESTED, RESUBMITTED, APPROVED, CLOSED, CANCELLED
  status            String    @default("ASSIGNED")
  
  // Priority: LOW, MEDIUM, HIGH, CRITICAL
  priority          String    @default("MEDIUM")
  
  siteName          String    // Snapshot for denormalized quick viewing
  siteAddress       String
  dueDate           DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  closedAt          DateTime?
  complianceScore   Float?    // Documented percentage compliance score calculated on submission
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        InspectionTemplate  @relation(fields: [templateId], references: [id])
  templateVersion TemplateVersion     @relation(fields: [templateVersionId], references: [id])
  site            Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset           Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspector       User?               @relation("InspectorInspections", fields: [inspectorId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("CreatorInspections", fields: [createdById], references: [id])

  assignments     InspectionAssignment[]
  responses       InspectionResponse[]
  evidence        EvidenceFile[]
  gpsRecords      GPSRecord[]
  signatures      Signature[]
  findings        Finding[]
  actions         CorrectiveAction[]
  reviews         InspectionReview[]
  auditLogs       AuditLog[]
  reports         Report[]

  @@index([organizationId, status])
  @@index([inspectorId])
  @@index([siteId])
}

model InspectionAssignment {
  id           String    @id @default(cuid())
  inspectionId String
  userId       String
  role         String    @default("INSPECTOR") // LEAD_INSPECTOR, ASSISTANT, WITNESS
  assignedAt   DateTime  @default(now())

  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, userId])
}

model InspectionResponse {
  id           String    @id @default(cuid())
  inspectionId String
  questionId   String
  status       String?   // PASS, FAIL, NA, YES, NO
  notes        String?
  rating       Int?      // 1-5
  numberValue  Float?    // Numeric / measurement
  textValue    String?   // Text / single choice / date
  selectedOptions String? // JSON array for multi-choice
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inspection   Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question     TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  findings     Finding[]

  @@unique([inspectionId, questionId])
  @@index([inspectionId])
}

// -------------------------------------------------------------
// PART 11, 12, 13: EVIDENCE, GPS & DIGITAL SIGNATURES
// -------------------------------------------------------------

model EvidenceFile {
  id           String   @id @default(cuid())
  inspectionId String
  questionId   String?
  findingId    String?
  actionId     String?
  mediaType    String   @default("PHOTO") // PHOTO, VIDEO, ATTACHMENT
  fileUrl      String   // Data URL or object storage path
  fileName     String?
  caption      String?
  category     String?  // DEFICIENCY, RESOLUTION, GENERAL
  mimeType     String   @default("image/jpeg")
  fileSize     Int?
  uploadedAt   DateTime @default(now())

  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question     TemplateQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  finding      Finding?          @relation(fields: [findingId], references: [id], onDelete: SetNull)
  action       CorrectiveAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@index([findingId])
}

model GPSRecord {
  id           String   @id @default(cuid())
  inspectionId String
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  address      String?
  distanceFromSite Float? // Calculated distance in meters from assigned Site coordinates
  isWithinGeofence Boolean @default(true)
  timestamp    DateTime @default(now())

  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Signature {
  id               String   @id @default(cuid())
  inspectionId     String
  signerType       String   @default("INSPECTOR") // INSPECTOR, SITE_MANAGER, CLIENT, AUDITOR
  signerName       String
  signerTitle      String?
  signatureDataUrl String   // SVG / PNG Data URL
  ipAddress        String?
  signedAt         DateTime @default(now())

  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// -------------------------------------------------------------
// PART 14 & 15: FINDINGS & CORRECTIVE ACTIONS (CAPA WORKFLOW)
// -------------------------------------------------------------

model Finding {
  id             String   @id @default(cuid())
  organizationId String
  inspectionId   String
  questionId     String?
  responseId     String?
  siteId         String?
  assetId        String?
  findingCode    String   // e.g. "F-2026-001"
  title          String
  description    String
  severity       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  riskCategory   String   // e.g. "Fire Hazard", "Electrical", "Structural", "Housekeeping", "PPE"
  recommendation String?
  status         String   @default("OPEN") // OPEN, CAPA_CREATED, RESOLVED, CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection        Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question          TemplateQuestion?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  response          InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  site              Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset             Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  evidence          EvidenceFile[]
  correctiveActions CorrectiveAction[]

  @@index([organizationId, status])
  @@index([inspectionId])
}

model CorrectiveAction {
  id             String    @id @default(cuid())
  organizationId String
  inspectionId   String
  findingId      String
  siteId         String?
  actionCode     String    // e.g. "CAPA-2026-001"
  title          String
  description    String
  priority       String    @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  // Statuses: OPEN, ASSIGNED, IN_PROGRESS, PENDING_VERIFICATION, CLOSED, REOPENED, OVERDUE
  status         String    @default("ASSIGNED")
  
  assigneeId     String?
  verifierId     String?
  dueDate        DateTime
  completedAt    DateTime?
  verifiedAt     DateTime?
  resolutionNotes String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  finding      Finding                   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  site         Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assignee     User?                     @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  verifier     User?                     @relation("ActionVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  evidence     EvidenceFile[]
  comments     CorrectiveActionComment[]

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([findingId])
}

model CorrectiveActionComment {
  id        String   @id @default(cuid())
  actionId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  action CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

// -------------------------------------------------------------
// PART 8, 18, 19, 20: REVIEWS, NOTIFICATIONS, AUDIT & REPORTS
// -------------------------------------------------------------

model InspectionReview {
  id           String   @id @default(cuid())
  inspectionId String
  reviewerId   String
  status       String   // APPROVED, CHANGES_REQUESTED, REJECTED
  feedback     String?
  reviewedAt   DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@index([inspectionId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           String    @default("INFO") // ASSIGNMENT, REVIEW, CAPA, DEADLINE, SYSTEM
  linkUrl        String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  inspectionId   String?
  title          String
  reportType     String   @default("AUDIT_CERTIFICATE") // AUDIT_CERTIFICATE, CAPA_SUMMARY, SITE_COMPLIANCE
  format         String   @default("PDF") // PDF, CSV
  fileUrl        String?
  generatedBy    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  inspectionId   String?
  action         String   // LOGIN, INSPECTION_CREATED, SUBMITTED, APPROVED, CAPA_RESOLVED, TEMPLATE_PUBLISHED
  entity         String   // Inspection, CorrectiveAction, Template, User
  entityId       String?
  details        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inspection   Inspection?   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([inspectionId])
}

model OfflineSyncOperation {
  id             String   @id @default(cuid())
  userId         String
  idempotencyKey String   @unique
  operation      String   // SAVE_DRAFT, SUBMIT_INSPECTION, CAPA_UPDATE
  entityType     String
  entityId       String
  payload        String   // JSON string of client offline mutation
  status         String   @default("PENDING") // PENDING, PROCESSED, FAILED, CONFLICT
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([idempotencyKey])
}
